# Copy this file to .env and provide at least ONE free API key (Google AI Studio Gemini, Groq, or OpenRouter).
# The client automatically falls back across whichever keys are configured.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.8-flash

GEMINI_API_KEY=your-google-ai-studio-api-key-here
# GROQ_API_KEY=your-groq-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
